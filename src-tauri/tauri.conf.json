{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AnyCompresssionThatMayWork",
  "version": "1.0.0",
  "identifier": "com.anycompresssionthatmaywork.app",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": {
      "../cli/compressor-cli.exe": "compressor-cli.exe"
    },
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh",
        "installerIcon": "icons/installer.ico",
        "uninstallerIcon": "icons/installer.ico"
      }
    }
  }
}
